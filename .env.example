# =============================================================================
# Green ERP — environment
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — must never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Credential encryption ---------------------------------------------------
# 32-byte key, base64-encoded. Encrypts channel tokens before they touch Postgres.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# --- Shopify (Phase 3) -------------------------------------------------------
# Leave blank until the Shopify Partner app exists. While blank, stores fall
# back to the mock provider and the whole order pipeline still runs end to end.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_products,write_products,read_inventory,write_inventory,read_fulfillments,write_fulfillments,read_customers,read_locations
SHOPIFY_API_VERSION=2025-01
SHOPIFY_APP_URL=http://localhost:3000

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
